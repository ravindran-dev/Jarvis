# JARVIS Command Aliases
# Resolved through the installed production binary at /usr/bin/jarvis

# Convenient shortcuts that don't overwrite native Linux utils
alias monitor="jarvis monitor"
alias cpu="jarvis cpu"
alias memory="jarvis memory"
alias storage="jarvis storage"
alias network="jarvis network"
alias processes="jarvis processes"
alias services="jarvis services"
# NOTE: 'users' is a real coreutils command (/usr/bin/users) — do NOT alias it
alias jusers="jarvis users"
alias commands="jarvis commands"
alias settings="jarvis settings"
